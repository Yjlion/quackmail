# name: test/sql/sieve.test
# description: the RFC 5228 Sieve parser accepts real scripts and rejects broken ones
# group: [quackmail]
#
# This checks the parser, which is what ManageSieve's PUTSCRIPT/CHECKSCRIPT
# gate on. Evaluation semantics (which folder a message actually lands in) are
# covered end to end by test/integration/test_managesieve.py.

require quackmail

# ---- scripts that must parse ----------------------------------------------

# The minimal script.
query I
SELECT qm_sieve_valid('keep;');
----
true

# An empty script is legal and simply does nothing.
query I
SELECT qm_sieve_valid('');
----
true

# require + a guarded fileinto: the common case.
query I
SELECT qm_sieve_valid('
require ["fileinto"];
if header :contains "Subject" "[list]" {
    fileinto "Lists";
}
');
----
true

# if / elsif / else chains.
query I
SELECT qm_sieve_valid('
require ["fileinto"];
if address :domain :is "From" "spam.example" {
    discard;
} elsif header :matches "Subject" "*urgent*" {
    fileinto "Urgent";
} else {
    keep;
}
');
----
true

# anyof / allof / not, and the envelope test.
query I
SELECT qm_sieve_valid('
require ["envelope", "fileinto"];
if allof (
     anyof (header :contains "To" "sales", header :contains "Cc" "sales"),
     not envelope :domain :is "From" "internal.example"
   ) {
    fileinto "Sales";
    stop;
}
');
----
true

# size with the K/M/G suffixes.
query I
SELECT qm_sieve_valid('if size :over 5M { discard; }');
----
true

query I
SELECT qm_sieve_valid('if size :under 100 { keep; }');
----
true

# exists, redirect, reject, and fileinto :create / :copy.
query I
SELECT qm_sieve_valid('
require ["fileinto", "reject", "copy"];
if exists ["X-Spam-Flag"] { reject "no thanks"; }
if header :is "X-Backup" "yes" { redirect :copy "archive@example.com"; }
fileinto :create "Archive/2026";
');
----
true

# Comments in both forms, and a multi-line text: block.
query I
SELECT qm_sieve_valid('
    # a hash comment, indented so sqllogictest does not eat it
/* a block
   comment */
require ["reject"];
if header :contains "Subject" "spam" {
    reject text:
This message was refused.
Please do not send it again.
.
;
}
');
----
true

# String lists in both argument positions.
query I
SELECT qm_sieve_valid('
if header :contains ["To", "Cc", "Bcc"] ["alice@", "bob@"] { keep; }
');
----
true

# A comparator, explicitly.
query I
SELECT qm_sieve_valid('
if header :comparator "i;octet" :is "Subject" "Exact" { discard; }
');
----
true

# ---- scripts that must be rejected ----------------------------------------

# Missing semicolon.
query I
SELECT qm_sieve_valid('keep');
----
false

# Unclosed block.
query I
SELECT qm_sieve_valid('if header :is "Subject" "x" { keep;');
----
false

# Unknown command.
query I
SELECT qm_sieve_valid('frobnicate "everything";');
----
false

# Unknown test.
query I
SELECT qm_sieve_valid('if telepathy :is "Subject" "x" { keep; }');
----
false

# Unterminated string.
query I
SELECT qm_sieve_valid('if header :is "Subject" "x { keep; }');
----
false

# size without :over or :under has no meaning.
query I
SELECT qm_sieve_valid('if size 100 { keep; }');
----
false

# else with no preceding if.
query I
SELECT qm_sieve_valid('else { keep; }');
----
false

# ---- the table-function form reports why -----------------------------------

query I
SELECT ok FROM qm_sieve_check('keep;');
----
true

# The error names the line, which is what ManageSieve hands back to the client.
query I
SELECT note LIKE '%line%' FROM qm_sieve_check('keep');
----
true

query I
SELECT ok FROM qm_sieve_check('frobnicate "x";');
----
false

# ---- the rule view ---------------------------------------------------------
# A rule builder needs to show a script as a list of rules and write one back.
# The script text stays the single source of truth: quackmail_sieve_scripts is
# also written by ManageSieve and by the admin console, so keeping structured
# rules in a table beside it would mean regenerating destroys an out-of-band
# edit, or trusting the table makes the UI describe filtering that is not what
# runs. So rules are *derived* from the text every time.

# The ordinary case: a name from the comment, the condition, the action.
query I
SELECT qm_sieve_rules(E'require ["fileinto"];\n# rule: Newsletters\nif header :contains "from" "news@" {\n  fileinto "Lists";\n}\n');
----
Newsletters|all|from contains news@|fileinto Lists

# A name belongs to the `if` it sits directly above. Anything in between means it
# was a comment about something else — a comment at the top of a file is a file
# comment, not the first rule's name, and borrowing it would put a stranger's
# words on someone's rule.
query I
SELECT qm_sieve_rules(E'# rule: Not a rule name\nrequire ["fileinto"];\nif header :contains "from" "news@" {\n  fileinto "Lists";\n}\n');
----
|all|from contains news@|fileinto Lists

# allof and anyof, several conditions, several actions, and a trailing stop.
query I
SELECT qm_sieve_rules(E'require ["fileinto"];\n# rule: Loud\nif anyof (header :is "subject" "SALE", header :contains "from" "spam.example") {\n  fileinto "Junk";\n  stop;\n}\n');
----
Loud|any|subject is SALE,from contains spam.example|fileinto Junk|stop

# A negated condition, a header the UI does not name directly, size and body.
query I
SELECT qm_sieve_rules(E'if allof (not header :contains "to" "me@x", header :is "x-mailer" "thing", size :over 100000, body :text :contains "unsubscribe") {\n  discard;\n}\n');
----
|all|!to contains me@x,header:x-mailer is thing,size over 100000,body contains unsubscribe|discard

# Several rules, and an unnamed one keeps its position rather than borrowing the
# next rule's name — which is what a naive "next comment wins" would do.
#
# One rule per line, joined with " / " so the whole answer is a single value: an
# expected block spanning lines is read as several *rows*.
query I
SELECT replace(qm_sieve_rules(E'# rule: First\nif header :is "from" "a@x" {\n  keep;\n}\nif header :is "from" "b@x" {\n  discard;\n}\n# rule: Third\nif header :is "from" "c@x" {\n  redirect "d@x";\n}\n'), chr(10), ' / ');
----
First|all|from is a@x|keep / |all|from is b@x|discard / Third|all|from is c@x|redirect d@x

# ---- what the rule view refuses to show -----------------------------------
# Each of these must decompose to NULL with a reason, so the UI falls back to the
# text editor. Silently showing a partial decomposition would describe filtering
# the server does not do.

query I
SELECT count(*) FROM (VALUES
    -- a nested rule
    (E'if header :is "from" "a@x" {\n  if header :is "to" "b@x" {\n    discard;\n  }\n}\n'),
    -- an else branch
    (E'if header :is "from" "a@x" {\n  keep;\n} else {\n  discard;\n}\n'),
    -- an action outside any rule
    (E'require ["fileinto"];\nfileinto "Inbox";\n'),
    -- a test the flat view does not model
    (E'if envelope :is "from" "a@x" {\n  discard;\n}\n'),
    (E'if exists "x-spam" {\n  discard;\n}\n'),
    -- a rule that can never run
    (E'if false {\n  keep;\n}\n'),
    -- several headers or values in one test
    (E'if header :is ["from", "to"] "a@x" {\n  keep;\n}\n'),
    (E'if header :is "from" ["a@x", "b@x"] {\n  keep;\n}\n'),
    -- not something that parses at all
    ('if header :is {')
) AS t(s)
WHERE qm_sieve_rules(s) IS NOT NULL;
----
0

# `if true` used to be on that list. It is not any more: it is how the rule view
# spells an *unconditional* rule, which is the shape an out-of-office reply has
# — "when should I auto-reply?" answers "always" far more often than it answers
# a condition, and a rule list that could not say "always" could not describe
# one. Compose writes it back the same way.
query I
SELECT qm_sieve_rules(E'if true {\n  keep;\n}\n');
----
|all||keep

# And each of those gives a reason rather than an empty failure, so the banner
# can say something useful.
query IIII
SELECT qm_sieve_rules_why(E'if header :is "from" "a@x" {\n  if header :is "to" "b@x" {\n    discard;\n  }\n}\n') LIKE '%nests one rule inside another%',
       qm_sieve_rules_why(E'if header :is "from" "a@x" {\n  keep;\n} else {\n  discard;\n}\n') LIKE '%else%',
       qm_sieve_rules_why(E'require ["fileinto"];\nfileinto "Inbox";\n') LIKE '%outside any rule%',
       qm_sieve_rules_why('if header :is {') LIKE '%does not parse%';
----
true	true	true	true

# A script the rule view *can* show has no reason to report.
query I
SELECT qm_sieve_rules_why(E'if header :is "from" "a@x" {\n  keep;\n}\n');
----
NULL

# ---- the round trip --------------------------------------------------------
# Compose is the only writer, so whatever it produces must parse — and must
# decompose to the same rules it came from, or saving twice would drift.

query I
SELECT qm_sieve_valid(qm_sieve_recompose(s))
FROM (SELECT E'# rule: Keep it\nrequire ["fileinto", "reject"];\nif anyof (header :contains "from" "a@x", not header :is "subject" "ok", size :over 1000) {\n  fileinto "Box";\n  reject "no thanks";\n  stop;\n}\n' AS s);
----
true

query I
SELECT qm_sieve_rules(qm_sieve_recompose(s)) = qm_sieve_rules(s)
FROM (SELECT E'# rule: Keep it\nrequire ["fileinto", "reject"];\nif anyof (header :contains "from" "a@x", not header :is "subject" "ok", size :over 1000) {\n  fileinto "Box";\n  reject "no thanks";\n  stop;\n}\n' AS s);
----
true

# Recomposing is idempotent at the text level too, so a save that changes nothing
# writes nothing new.
query I
SELECT qm_sieve_recompose(qm_sieve_recompose(s)) = qm_sieve_recompose(s)
FROM (SELECT E'# rule: R\nif header :is "from" "a@x" {\n  fileinto "B";\n}\n' AS s);
----
true

# `require` is emitted from the actions actually used, so a script does not claim
# to need an extension it never invokes.
query III
SELECT qm_sieve_recompose(E'if header :is "from" "a@x" {\n  discard;\n}\n') LIKE '%require%',
       qm_sieve_recompose(E'require ["fileinto"];\nif header :is "from" "a@x" {\n  fileinto "B";\n}\n') LIKE '%"fileinto"%',
       qm_sieve_recompose(E'require ["fileinto"];\nif header :is "from" "a@x" {\n  fileinto "B";\n}\n') LIKE '%reject%';
----
false	true	false

# A value containing a quote or a backslash survives the round trip rather than
# ending the string early.
query I
SELECT qm_sieve_rules(qm_sieve_recompose(E'if header :is "subject" "a \\"quoted\\" word" {\n  keep;\n}\n'));
----
|all|subject is a "quoted" word|keep

# ---- imap4flags (RFC 5232) -------------------------------------------------

query I
SELECT qm_sieve_valid('
require ["imap4flags", "fileinto"];
setflag "\\Seen";
addflag ["\\Flagged", "$label1"];
removeflag "\\Seen";
if hasflag "\\Flagged" { fileinto :flags "\\Seen" "Box"; }
keep :flags [];
');
----
true

# The flags an action carries are the internal set *as it stood when that action
# ran*. An addflag afterwards must not reach back and change what was already
# filed — which is the entire subtlety of §5, and the thing a parse test cannot
# see.
query I
SELECT replace(qm_sieve_eval(E'require ["imap4flags", "fileinto"];\naddflag "\\\\Seen";\nfileinto "Early";\naddflag "\\\\Flagged";\nfileinto "Late";\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto Early +\Seen / fileinto Late +\Seen +\Flagged

# `:flags` on the action overrides the internal set, and `:flags []` means "no
# flags", which is a different thing from not writing the tag at all.
query I
SELECT replace(qm_sieve_eval(E'require ["imap4flags", "fileinto"];\nsetflag "\\\\Seen";\nfileinto :flags "\\\\Flagged" "A";\nfileinto :flags [] "B";\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto A +\Flagged / fileinto B

# System flags fold case on the wire, so `\seen` and `\Seen` are one flag and
# are stored under IMAP's spelling. A keyword is passed through as written.
query I
SELECT replace(qm_sieve_eval(E'require ["imap4flags"];\nsetflag "\\\\seen \\\\SEEN $Work";\nkeep;\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep +\Seen +$Work

# setflag replaces, addflag adds, removeflag takes away.
query I
SELECT replace(qm_sieve_eval(E'require ["imap4flags"];\naddflag "\\\\Flagged";\nsetflag "\\\\Draft";\naddflag "\\\\Seen";\nremoveflag "\\\\Draft";\nkeep;\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep +\Seen

# ---- variables (RFC 5229) --------------------------------------------------

query I
SELECT qm_sieve_valid('
require ["variables", "fileinto"];
set "name" "value";
set :lower :upperfirst "greeting" "HELLO";
set :length "n" "abcd";
if string :is "${name}" "value" { fileinto "${greeting}"; }
');
----
true

# ${...} expands in a fileinto argument.
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nset "box" "Lists";\nfileinto "${box}";\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto Lists

# **Without `require "variables"` the same script files into a folder literally
# called `${box}`.** This is the one capability that is not advisory: a script
# written before the extension existed must keep meaning what it meant then.
query I
SELECT replace(qm_sieve_eval(E'require ["fileinto"];\nset "box" "Lists";\nfileinto "${box}";\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto ${box}

# `:matches` captures into ${1}..${9}, which is what makes a per-sender or
# per-list folder expressible at all.
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nif header :matches "Subject" "[*] *" {\n  fileinto "Lists/${1}";\n}\n',
                     E'Subject: [duckdb] a question\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto Lists/duckdb

# ${0} is everything the pattern matched.
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nif header :matches "Subject" "re: *" {\n  fileinto "${0}";\n}\n',
                     E'Subject: re: hello\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto re: hello

# A failed match leaves the previous captures alone rather than clearing them:
# reading ${1} from a test that never fired would be worse than reading a stale
# one, because nothing would say so.
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nif header :matches "Subject" "[*] *" { keep; }\nif header :matches "Subject" "zzz*" { keep; }\nfileinto "${1}";\n',
                     E'Subject: [duckdb] a question\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep / fileinto duckdb

# An unset variable is the empty string, not an error and not the literal text.
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nfileinto "A${nope}B";\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto AB

# Something that is not a variable name is left exactly as written (§3).
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nfileinto "${} ${a b} ${";\n',
                     E'Subject: hi\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto ${} ${a b} ${

# Expansion is not recursive: a value holding ${...} is data. Otherwise a
# sender who gets text into a variable could have it read back as script.
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nset "inner" "Box";\nset "outer" "${inner}";\nif header :matches "Subject" "*" { }\nfileinto "${outer}";\n',
                     E'Subject: ${inner}\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
fileinto Box

# set modifiers, applied by precedence rather than in the order written (§4.1).
query IIII
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nset :lower "v" "HELLO";\nfileinto "${v}";\n', E'Subject: x\r\n\r\n', 'a@x.test', 'b@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nset :upper "v" "hello";\nfileinto "${v}";\n', E'Subject: x\r\n\r\n', 'a@x.test', 'b@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nset :lower :upperfirst "v" "hELLO";\nfileinto "${v}";\n', E'Subject: x\r\n\r\n', 'a@x.test', 'b@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nset :length "v" "abcd";\nfileinto "${v}";\n', E'Subject: x\r\n\r\n', 'a@x.test', 'b@y.test'), chr(10), ' / ');
----
fileinto hello	fileinto HELLO	fileinto Hello	fileinto 4

# :quotewildcard escapes a captured value before it is used as a pattern, which
# is what stops a subject full of '*' from matching everything afterwards.
query I
SELECT replace(qm_sieve_eval(E'require ["variables", "fileinto"];\nset :quotewildcard "v" "a*b";\nfileinto "${v}";\n',
                     E'Subject: x\r\n\r\n', 'a@x.test', 'b@y.test'), chr(10), ' / ');
----
fileinto a\*b

# ---- vacation (RFC 5230) ---------------------------------------------------

query I
SELECT qm_sieve_valid('
require ["vacation"];
vacation :days 3 :subject "Away" :from "me@example.com" :handle "h" :addresses ["a@x", "b@x"] :mime
  text:
I am away until Monday.
.
;
');
----
true

# The ordinary case: a person writes to a person, and the reply is warranted.
# The implicit keep survives — an out-of-office is not a delivery, so the
# message still lands in the inbox.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation :days 3 "Away until Monday";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\nSubject: lunch?\r\n\r\nbody',
                     'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
vacation days=3 Away until Monday / keep

# Every reason RFC 5230 gives for staying quiet, one at a time. Each of these
# fails *silently* against a real correspondent, which is why they are pinned
# here rather than left to an integration test to notice.

# §4.6 — the message was itself generated.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\nAuto-Submitted: auto-replied\r\n\r\nbody',
                     'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep

# `Auto-Submitted: no` is the one value that means "an ordinary message".
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\nAuto-Submitted: no\r\n\r\nbody',
                     'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
vacation days=7 Away / keep

# A mailing list. Replying to one is how an out-of-office reaches four hundred
# people who did not write to anybody.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: list@y.test\r\nList-Id: <l.y.test>\r\n\r\nbody',
                     'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep

query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\nPrecedence: bulk\r\n\r\nbody',
                     'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep

# An empty envelope sender is a bounce or a notification. Answering one is how
# two servers talk to each other until somebody notices.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\n\r\nbody', '', 'bob@y.test'), chr(10), ' / ');
----
keep

# §4.5 — the user has to be a visible recipient. Without this, every message a
# rule routed here and every thread the user was bcc'd on gets an answer.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: someone-else@y.test\r\n\r\nbody',
                     'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep

# ...and Cc counts, as does an address named by :addresses.
query II
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: c@y.test\r\nCc: bob@y.test\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["vacation"];\nvacation :addresses ["robert@y.test"] "Away";\n',
                     E'From: a@x.test\r\nTo: robert@y.test\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
vacation days=7 Away / keep	vacation days=7 Away / keep

# Never answer yourself.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: bob@y.test\r\nTo: bob@y.test\r\n\r\nbody', 'bob@y.test', 'bob@y.test'), chr(10), ' / ');
----
keep

# §4.7 — one reply per message however many times the command is reached.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "First";\nvacation "Second";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
vacation days=7 First / keep

# §4.1 — the window defaults to seven days and has a floor of one, because an
# auto-replier with no floor answers a persistent correspondent every time.
query II
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["vacation"];\nvacation :days 0 "Away";\n',
                     E'From: a@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'a@x.test', 'bob@y.test'), chr(10), ' / ');
----
vacation days=7 Away / keep	vacation days=7 Away / keep

# RFC 3834 §2 — never answer a robot, identified by its local part. The empty
# return path rule catches a well-formed bounce and the Auto-Submitted rule
# catches a well-behaved robot; this is for the ones that are neither.
query IIII
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: d@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'MAILER-DAEMON@x.test', 'bob@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: d@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'postmaster@x.test', 'bob@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: d@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'devs-request@x.test', 'bob@y.test'), chr(10), ' / '),
       replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: d@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'owner-devs@x.test', 'bob@y.test'), chr(10), ' / ');
----
keep	keep	keep	keep

# A person whose name merely contains one of those words is still a person.
query I
SELECT replace(qm_sieve_eval(E'require ["vacation"];\nvacation "Away";\n',
                     E'From: d@x.test\r\nTo: bob@y.test\r\n\r\nbody', 'postmasters-guild@x.test', 'bob@y.test'), chr(10), ' / ');
----
vacation days=7 Away / keep

# ---- what the rule editor can and cannot show -------------------------------

# A script requiring `variables` is refused outright rather than shown without
# them: a variable's value depends on what ran before it, and a list of
# independent rules has no "before".
query II
SELECT qm_sieve_rules(E'require ["variables"];\nset "a" "b";\nif header :is "subject" "x" { keep; }\n') IS NULL,
       qm_sieve_rules_why(E'require ["variables"];\nif header :is "subject" "x" { keep; }\n');
----
true	This script uses variables, which the rule editor cannot show.

# So is a bare setflag: it changes what runs after it, and the builder writes
# flags as `:flags` on the action they belong to instead.
query I
SELECT qm_sieve_rules_why(E'require ["imap4flags"];\nif header :is "subject" "x" {\n  addflag "\\\\Seen";\n  keep;\n}\n');
----
This script sets flags or variables as separate commands, which the rule editor cannot show.

# An unconditional rule — `if true` — is what an out-of-office is, and the rule
# view shows it with no conditions rather than refusing it.
query I
SELECT qm_sieve_rules(E'require ["vacation"];\n# rule: Out of office\nif true {\n  vacation :days 3 "Away";\n}\n');
----
Out of office|all||vacation Away

# **`fileinto :create` survives the round trip.** Decompose reads it, so Compose
# has to write it: dropping it would silently rewrite a script that asked for it
# the first time any *other* rule on the page was touched.
query II
SELECT qm_sieve_rules(E'require ["fileinto", "mailbox"];\nif header :is "subject" "x" {\n  fileinto :create "A/B";\n}\n'),
       qm_sieve_recompose(E'require ["fileinto", "mailbox"];\nif header :is "subject" "x" {\n  fileinto :create "A/B";\n}\n') LIKE '%:create%';
----
|all|subject is x|fileinto A/B :create	true

# Flags on an action survive it too, and bring their own require line.
query II
SELECT qm_sieve_rules(qm_sieve_recompose(E'require ["fileinto", "imap4flags"];\nif header :is "subject" "x" {\n  fileinto :flags "\\\\Seen" "A";\n}\n')),
       qm_sieve_recompose(E'require ["fileinto", "imap4flags"];\nif header :is "subject" "x" {\n  fileinto :flags "\\\\Seen" "A";\n}\n') LIKE '%imap4flags%';
----
|all|subject is x|fileinto A +\Seen	true

# A vacation rule round-trips, multi-line message and all: quoting the message
# would run every paragraph together, so Compose writes a `text:` block.
query I
SELECT qm_sieve_valid(qm_sieve_recompose(E'require ["vacation"];\nif true {\n  vacation text:\nLine one.\nLine two.\n.\n;\n}\n'));
----
true

query I
SELECT qm_sieve_rules(qm_sieve_recompose(E'require ["vacation"];\nif true {\n  vacation text:\nLine one.\nLine two.\n.\n;\n}\n')) =
       qm_sieve_rules(E'require ["vacation"];\nif true {\n  vacation text:\nLine one.\nLine two.\n.\n;\n}\n');
----
true

# **`:mime` survives too**, for the same reason `:create` has to. Decompose has
# always read it, and Compose did not write it, so touching any *other* rule on
# the page silently stripped it from a hand-written script and turned the reply
# body into literal MIME source.
query I
SELECT qm_sieve_recompose(E'require ["vacation"];\nif true {\n  vacation :mime :days 3 "Content-Type: text/html\n\n<p>Away</p>";\n}\n') LIKE '%:mime%';
----
true
