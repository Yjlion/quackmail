# name: test/sql/mime.test
# description: MIME & message-format helpers (RFC 2045-2049, 822/2822/5322)
# group: [quackmail]

require quackmail

# --- RFC 2045 Content-Transfer-Encoding decoding ---------------------------

# base64
query I
SELECT decoded FROM qm_mime_decode('base64', 'SGVsbG8sIHdvcmxkIQ==');
----
Hello, world!

# quoted-printable: =XX hex escapes
query I
SELECT decoded FROM qm_mime_decode('quoted-printable', '=48=65=6C=6C=6F x=3Dy');
----
Hello x=y

# quoted-printable: soft line break (trailing '=' before newline)
query I
SELECT decoded FROM qm_mime_decode('quoted-printable', 'a=' || chr(10) || 'b');
----
ab

# --- RFC 2047 encoded-word decoding ----------------------------------------

# B (base64) encoded word
query I
SELECT decoded FROM qm_mime_decode_header('=?UTF-8?B?SGVsbG8=?=');
----
Hello

# Q encoded word: '_' is space, =XX hex
query I
SELECT decoded FROM qm_mime_decode_header('=?UTF-8?Q?a_b=3Dc?=');
----
a b=c

# ISO-8859-1 (Latin-1) transcoded to UTF-8: 0xE9 -> é
query I
SELECT decoded FROM qm_mime_decode_header('=?ISO-8859-1?Q?caf=E9?=');
----
café

# Adjacent encoded words: whitespace between them is dropped (RFC 2047 §6.2)
query I
SELECT decoded FROM qm_mime_decode_header('=?UTF-8?B?SGVsbG8=?= =?UTF-8?B?V29ybGQ=?=');
----
HelloWorld

# Non-encoded whitespace is preserved
query I
SELECT decoded FROM qm_mime_decode_header('plain =?UTF-8?B?dGV4dA==?= here');
----
plain text here

# --- RFC 5322 address-list parsing -----------------------------------------

query TT
SELECT name, address FROM qm_mime_addresses('"Doe, John" <john@example.com>, Jane <jane@example.org>');
----
Doe, John	john@example.com
Jane	jane@example.org

# Group syntax: label stripped, members returned individually
query TT
SELECT name, address FROM qm_mime_addresses('Team: a@x.com, b@y.com;');
----
(empty)	a@x.com
(empty)	b@y.com

# Bare addr-spec with a trailing comment
query TT
SELECT name, address FROM qm_mime_addresses('bob@example.com (Bob)');
----
(empty)	bob@example.com

# --- RFC 5322 date parsing -------------------------------------------------

query IT
SELECT epoch, iso FROM qm_parse_date('Mon, 02 Jan 2006 15:04:05 -0700');
----
1136239445	2006-01-02T22:04:05Z

# Named zone
query I
SELECT epoch FROM qm_parse_date('2 Jan 2006 22:04:05 GMT');
----
1136239445

# --- RFC 2046 multipart decomposition --------------------------------------

query TTTT
SELECT section, content_type, filename, content FROM qm_mime_parts(
  'Content-Type: multipart/mixed; boundary="B"' || chr(10) || chr(10) ||
  'preamble' || chr(10) ||
  '--B' || chr(10) ||
  'Content-Type: text/plain' || chr(10) || chr(10) ||
  'hello' || chr(10) ||
  '--B' || chr(10) ||
  'Content-Type: text/plain' || chr(10) ||
  'Content-Disposition: attachment; filename="a.txt"' || chr(10) ||
  'Content-Transfer-Encoding: base64' || chr(10) || chr(10) ||
  'SGk=' || chr(10) ||
  '--B--' || chr(10) ||
  'epilogue');
----
1	text/plain	(empty)	hello
2	text/plain	a.txt	Hi

# A single-part message is section "1"
query TT
SELECT section, content FROM qm_mime_parts(
  'Content-Type: text/plain' || chr(10) || chr(10) || 'just text');
----
1	just text

# --- header extraction -----------------------------------------------------

query TT
SELECT name, value FROM qm_mime_headers(
  'Subject: Hi' || chr(10) || 'From: a@b.com' || chr(10) || chr(10) || 'body');
----
Subject	Hi
From	a@b.com

# ---- building --------------------------------------------------------------
# Assembling a message is the inverse of parsing it, and the nesting a set of
# parts turns into is a decision with several wrong answers. qm_mime_shape
# reports the tree the parser then finds, which is the real question: did each
# part end up somewhere a mail client will look for it?

# One text part stays one part. Wrapping a plain note in a pointless multipart is
# the classic mistake here.
query I
SELECT qm_mime_shape('Just a note.', '', 0, 0);
----
text/plain

# Two bodies become alternative, and text/plain comes *first*: the list is
# least-preferred first, and a client shows the last part it understands. Getting
# this backwards shows the plain text to everyone.
query I
SELECT qm_mime_shape('Plain.', '<p>Rich.</p>', 0, 0);
----
alternative(text/plain,text/html)

# An inline image the HTML refers to by cid: goes in a related wrapper around the
# alternative — not beside it, or the client cannot resolve the reference.
query I
SELECT qm_mime_shape('Plain.', '<p><img src="cid:img0@test"></p>', 1, 0);
----
related(alternative(text/plain,text/html),image/png)

# Attachments go outermost, so a client that shows the body never has to walk
# past them.
query II
SELECT qm_mime_shape('Plain.', '<p>Rich.</p>', 0, 1),
       qm_mime_shape('Plain.', '<p>Rich.</p>', 1, 1);
----
mixed(alternative(text/plain,text/html),application/pdf)	mixed(related(alternative(text/plain,text/html),image/png),application/pdf)

# Attachments on a plain-text message need no alternative at all.
query II
SELECT qm_mime_shape('Just text.', '', 0, 1),
       qm_mime_shape('Just text.', '', 0, 2);
----
mixed(text/plain,application/pdf)	mixed(text/plain,application/pdf,application/pdf)

# An HTML-only message is a single part, not an alternative with one child.
query I
SELECT qm_mime_shape('', '<p>Rich only.</p>', 0, 0);
----
text/html

# A message with nothing in it is still a message rather than a parse error.
query I
SELECT qm_mime_shape('', '', 0, 0);
----
text/plain

# The framing headers are the builder's to set. A caller cannot also supply them
# and so cannot disagree with what is emitted — exactly one MIME-Version.
query II
SELECT length(qm_mime_build('x', '', 0, 0)) -
       length(replace(qm_mime_build('x', '', 0, 0), 'MIME-Version:', '')),
       qm_mime_build('x', '<p>y</p>', 0, 0) LIKE '%multipart/alternative; boundary="=_qc_%';
----
13	true

# An inline part is marked inline and carries the Content-ID the HTML refers to;
# an attachment is marked as one and names its file.
query II
SELECT qm_mime_build('p', '<p>h</p>', 1, 0) LIKE '%Content-ID: <img0@test>%',
       qm_mime_build('p', '', 0, 1) LIKE '%Content-Disposition: attachment; filename="file0.pdf"%';
----
true	true

# ---- transfer encodings ----------------------------------------------------
# 8bit keeps a message readable in a raw dump, so it is preferred while the text
# allows it. A control character or an over-long line forces quoted-printable;
# anything not text/* is base64 regardless.

query IIIII
SELECT qm_mime_encoding('text/plain', 'hello'),
       qm_mime_encoding('text/plain', 'caf' || chr(233)),
       qm_mime_encoding('text/plain', 'a' || chr(1) || 'b'),
       qm_mime_encoding('text/plain', repeat('x', 1200)),
       qm_mime_encoding('image/png', 'hello');
----
8bit	8bit	quoted-printable	quoted-printable	base64

# A long *message* is fine as long as no single line is long: line length is what
# SMTP limits, not total size.
query I
SELECT qm_mime_encoding('text/plain', repeat('short line' || chr(10), 500));
----
8bit
