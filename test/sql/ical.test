# name: test/sql/ical.test
# description: iCalendar parsing, recurrence expansion and the edit path
# group: [quackmail]
#
# Two things here are worth more than the rest put together:
#
#   * a recurring event keeps its *local* hour across a DST change, rather than
#     drifting an hour, which is the bug every UTC-only calendar has;
#   * editing an event preserves the parts we do not model — the alarm someone
#     set on their phone has to still be there afterwards.

require quackmail

statement ok
LOAD quackmail;

# ---- parsing ---------------------------------------------------------------

query IIII
SELECT qm_ical_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:a@x\r\nDTSTART:20260315T090000Z\r\nSUMMARY:One\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n'),
       qm_ical_get(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:a@x\r\nDTSTART:20260315T090000Z\r\nSUMMARY:One\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 'VEVENT', 'SUMMARY'),
       qm_ical_euid(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:a@x\r\nDTSTART:20260315T090000Z\r\nSUMMARY:One\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n'),
       qm_ical_start(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:a@x\r\nDTSTART:20260315T090000Z\r\nSUMMARY:One\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n');
----
1	One	a@x	1773565200

# All three item kinds, and VTIMEZONE is not one of them.

query I
SELECT qm_ical_count(
  E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\n' ||
  E'BEGIN:VTIMEZONE\r\nTZID:UTC\r\nEND:VTIMEZONE\r\n' ||
  E'BEGIN:VEVENT\r\nUID:1@x\r\nDTSTART:20260315T090000Z\r\nEND:VEVENT\r\n' ||
  E'BEGIN:VTODO\r\nUID:2@x\r\nDUE:20260316T090000Z\r\nEND:VTODO\r\n' ||
  E'BEGIN:VJOURNAL\r\nUID:3@x\r\nDTSTART:20260317T090000Z\r\nEND:VJOURNAL\r\n' ||
  E'END:VCALENDAR\r\n');
----
3

# Not a calendar at all: no items, no guesses.

query II
SELECT qm_ical_count('just text'), qm_ical_start('just text');
----
0	NULL

# A TZID resolves through the bundled zone database. 2026-03-15 09:00 in New
# York is 13:00Z, because daylight saving started a week earlier.

query I
SELECT qm_ical_start(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:z@x\r\nDTSTART;TZID=America/New_York:20260315T090000\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n');
----
1773579600

# Escapes resolve, and RRULE keeps its semicolons — those are structure, not
# escaped text, so unescaping them would destroy the rule.

query II
SELECT qm_ical_get(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:e@x\r\nDTSTART:20260315T090000Z\r\nLOCATION:Room 3\\; upstairs\\, rear\r\nRRULE:FREQ=WEEKLY;BYDAY=TU;COUNT=5\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 'VEVENT', 'LOCATION'),
       qm_ical_get(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:e@x\r\nDTSTART:20260315T090000Z\r\nLOCATION:Room 3\\; upstairs\\, rear\r\nRRULE:FREQ=WEEKLY;BYDAY=TU;COUNT=5\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 'VEVENT', 'RRULE');
----
Room 3; upstairs, rear	FREQ=WEEKLY;BYDAY=TU;COUNT=5

# ---- recurrence ------------------------------------------------------------
# The forms that are supported, by count.

query IIIIII
SELECT qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=DAILY;COUNT=4\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800),
       qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=DAILY;INTERVAL=3;COUNT=3\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800),
       qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=DAILY;UNTIL=20260318T090000Z\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800),
       qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260316T090000Z\r\nRRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR;COUNT=6\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800),
       qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260115T090000Z\r\nRRULE:FREQ=MONTHLY;COUNT=4\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800),
       qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=YEARLY;COUNT=3\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
4	3	4	6	4	3

# An event with no rule at all occurs once.

query I
SELECT qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
1

# EXDATE removes an instance the rule would otherwise produce.

query I
SELECT qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=DAILY;COUNT=4\r\nEXDATE:20260316T090000Z\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
3

# A monthly rule on the 31st skips the months that have no 31st, rather than
# clamping to the 30th. RFC 5545 §3.3.10 is explicit: an invalid date is not
# generated. So Jan, Mar, May, Jul — not Feb.

query I
SELECT qm_ical_expand_starts(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260131T090000Z\r\nRRULE:FREQ=MONTHLY;COUNT=4\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
1769850000,1774947600,1780218000,1785488400

# An unbounded rule is capped rather than allowed to run: this expansion happens
# on a request thread, and a calendar with no COUNT and no UNTIL is normal.

query I
SELECT qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=DAILY\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
750

# A rule using a form this does not expand still puts the event on the calendar
# once. Vanishing would be worse than being incomplete.

query II
SELECT qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=MONTHLY;BYSETPOS=-1;BYDAY=FR\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800),
       qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=MONTHLY;BYDAY=2TU\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
1	1

# ---- the window boundary ---------------------------------------------------
# [from, to) is half-open, and the two shapes of occurrence have to be compared
# differently. An event with a duration overlaps while it has not yet ended; one
# without is a single instant. Treating an instant as a zero-length span makes
# "ends at or before `from`" reject an event starting on the window's very first
# second — which is exactly the occurrence a day view is asking for.
#
# 1773565200 is 2026-03-15T09:00Z, so these walk the edges either side of it.

query IIII
SELECT qm_ical_expand_count(ev, 1773565200, 1773738000),  -- starts on `from`
       qm_ical_expand_count(ev, 1773565201, 1773738000),  -- one second after
       qm_ical_expand_count(ev, 1773478800, 1773565200),  -- `to` lands on it
       qm_ical_expand_count(ev, 1773478800, 1773565201)   -- one second past it
FROM (SELECT E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nRRULE:FREQ=DAILY;COUNT=10\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n' AS ev);
----
2	1	0	1

# The same edges for an event that lasts an hour: it is still in the window
# while it is running, and gone once it has finished.

query III
SELECT qm_ical_expand_count(ev, 1773567000, 1773738000),  -- window opens mid-event
       qm_ical_expand_count(ev, 1773568800, 1773738000),  -- opens as it ends
       qm_ical_expand_count(ev, 1773568799, 1773738000)   -- one second before that
FROM (SELECT E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:r@x\r\nDTSTART:20260315T090000Z\r\nDTEND:20260315T100000Z\r\nRRULE:FREQ=DAILY;COUNT=10\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n' AS ev);
----
2	1	2

# ---- recurrence across a DST change ---------------------------------------
# The assertion this file exists for. A weekly 09:00 meeting in New York from
# 2026-10-20: the first two occurrences are 13:00Z (EDT), and after the clocks
# go back on 2026-11-01 they are 14:00Z (EST) — because 09:00 *local* is what
# was meant. A UTC-only implementation would keep 13:00Z and show 08:00 local.

query I
SELECT qm_ical_expand_starts(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:d@x\r\nDTSTART;TZID=America/New_York:20261020T090000\r\nDTEND;TZID=America/New_York:20261020T100000\r\nRRULE:FREQ=WEEKLY;COUNT=4\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
1792501200,1793106000,1793714400,1794319200

# Stated the other way round, so the intent is legible: every occurrence is at
# 09:00 New York time, and the UTC hour is what changes.

query II
SELECT list_sort(list_distinct(list_transform(
         str_split(qm_ical_expand_starts(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:d@x\r\nDTSTART;TZID=America/New_York:20261020T090000\r\nRRULE:FREQ=WEEKLY;COUNT=4\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800), ','),
         s -> (qm_tz_offset('America/New_York', CAST(s AS BIGINT)) + CAST(s AS BIGINT)) % 86400 // 3600))),
       list_sort(list_distinct(list_transform(
         str_split(qm_ical_expand_starts(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:d@x\r\nDTSTART;TZID=America/New_York:20261020T090000\r\nRRULE:FREQ=WEEKLY;COUNT=4\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800), ','),
         s -> CAST(s AS BIGINT) % 86400 // 3600)));
----
[9]	[13, 14]

# ---- DTEND, DURATION and all-day ------------------------------------------

query II
SELECT qm_ical_expand_count(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:u@x\r\nDTSTART:20260315T090000Z\r\nDURATION:PT90M\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800),
       qm_ical_expand_starts(E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:u@x\r\nDTSTART;VALUE=DATE:20260315\r\nRRULE:FREQ=DAILY;COUNT=3\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n', 0, 4102444800);
----
1	1773532800,1773619200,1773705600

# ---- the edit path ---------------------------------------------------------
# Changing the summary must not disturb anything else. The VALARM, the X-
# property, the parameters on ORGANIZER and ATTENDEE, and DTSTAMP all survive;
# SEQUENCE goes up, because a changed object has to say it changed.

query IIIIII
SELECT edited LIKE '%SUMMARY:Renamed%',
       edited LIKE '%BEGIN:VALARM%',
       edited LIKE '%TRIGGER:-PT15M%',
       edited LIKE '%X-PHONE-WROTE-THIS:keep me%',
       edited LIKE '%ATTENDEE;PARTSTAT=ACCEPTED:mailto:bob@example.com%',
       edited LIKE '%SEQUENCE:3%'
FROM (SELECT qm_ical_set_summary(
  E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\nBEGIN:VEVENT\r\nUID:m@x\r\nDTSTAMP:20260301T120000Z\r\n' ||
  E'DTSTART:20260315T090000Z\r\nSUMMARY:Original\r\nSEQUENCE:2\r\n' ||
  E'ORGANIZER;CN=Ada:mailto:ada@example.com\r\n' ||
  E'ATTENDEE;PARTSTAT=ACCEPTED:mailto:bob@example.com\r\n' ||
  E'X-PHONE-WROTE-THIS:keep me\r\n' ||
  E'BEGIN:VALARM\r\nACTION:DISPLAY\r\nTRIGGER:-PT15M\r\nEND:VALARM\r\n' ||
  E'END:VEVENT\r\nEND:VCALENDAR\r\n', 'Renamed') AS edited);
----
true	true	true	true	true	true

# ---- VTIMEZONE -------------------------------------------------------------
# A TZID with no VTIMEZONE beside it leaves Outlook and Thunderbird guessing, so
# one is generated from the bundled database. The transition instants have to be
# exact: a client that recomputes them from what we wrote must agree with us.

query III
SELECT vtz LIKE '%TZID:America/New_York%',
       vtz LIKE '%DTSTART:20260308T020000%',   -- clocks forward, 02:00 exactly
       vtz LIKE '%DTSTART:20261101T020000%'    -- clocks back
FROM (SELECT qm_ical_vtimezone('America/New_York', 2026, 2026) AS vtz);
----
true	true	true

query II
SELECT qm_ical_vtimezone('America/New_York', 2026, 2026) LIKE '%TZOFFSETTO:-0400%',
       qm_ical_vtimezone('Mars/Olympus', 2026, 2026);
----
true	NULL

# ---- free/busy -------------------------------------------------------------
# The absences are the contract here. A free/busy reply says when somebody is
# unavailable and nothing else, so what it *leaves out* is as load-bearing as
# what it reports, and none of it is visible in an interval list a reader could
# eyeball.

# Two meetings, 09:00-10:00 and 10:00-11:00 on the same day. They touch, so they
# are one unavailable stretch: reporting two would invite a client to offer the
# zero-length gap between them.
query III
SELECT fb LIKE '%BEGIN:VFREEBUSY%',
       fb LIKE '%FREEBUSY;FBTYPE=BUSY:20260315T090000Z/20260315T110000Z%',
       fb NOT LIKE '%SUMMARY%'   -- intervals only; never what the meeting is
FROM (SELECT qm_ical_freebusy(
  E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\n' ||
  E'BEGIN:VEVENT\r\nUID:a@x\r\nDTSTAMP:20260301T120000Z\r\n' ||
  E'DTSTART:20260315T090000Z\r\nDTEND:20260315T100000Z\r\nSUMMARY:Standup\r\nEND:VEVENT\r\n' ||
  E'BEGIN:VEVENT\r\nUID:b@x\r\nDTSTAMP:20260301T120000Z\r\n' ||
  E'DTSTART:20260315T100000Z\r\nDTEND:20260315T110000Z\r\nSUMMARY:Review\r\nEND:VEVENT\r\n' ||
  E'END:VCALENDAR\r\n', 1773532800, 1773792000) AS fb);
----
true	true	true

# TRANSP:TRANSPARENT and STATUS:CANCELLED contribute nothing. The property
# exists precisely so an entry can sit on a calendar without claiming the
# person — an all-day "on holiday" marker is the usual one — and a cancelled
# meeting is not a commitment. Both events below span the whole window, so if
# either counted there would be no free time at all.
query II
SELECT fb NOT LIKE '%FREEBUSY;%',   -- the property, not BEGIN:VFREEBUSY
       fb LIKE '%DTSTART:20260315T000000Z%'
FROM (SELECT qm_ical_freebusy(
  E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\n' ||
  E'BEGIN:VEVENT\r\nUID:c@x\r\nDTSTAMP:20260301T120000Z\r\nTRANSP:TRANSPARENT\r\n' ||
  E'DTSTART:20260315T000000Z\r\nDTEND:20260316T000000Z\r\nSUMMARY:On leave\r\nEND:VEVENT\r\n' ||
  E'BEGIN:VEVENT\r\nUID:d@x\r\nDTSTAMP:20260301T120000Z\r\nSTATUS:CANCELLED\r\n' ||
  E'DTSTART:20260315T000000Z\r\nDTEND:20260316T000000Z\r\nSUMMARY:Called off\r\nEND:VEVENT\r\n' ||
  E'END:VCALENDAR\r\n', 1773532800, 1773619200) AS fb);
----
true	true

# STATUS:TENTATIVE is busy under a different FBTYPE, because a client draws a
# maybe differently from a commitment.
query II
SELECT fb LIKE '%FBTYPE=BUSY-TENTATIVE:20260315T140000Z/20260315T150000Z%',
       fb NOT LIKE '%FBTYPE=BUSY:%'
FROM (SELECT qm_ical_freebusy(
  E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\n' ||
  E'BEGIN:VEVENT\r\nUID:e@x\r\nDTSTAMP:20260301T120000Z\r\nSTATUS:TENTATIVE\r\n' ||
  E'DTSTART:20260315T140000Z\r\nDTEND:20260315T150000Z\r\nSUMMARY:Maybe\r\nEND:VEVENT\r\n' ||
  E'END:VCALENDAR\r\n', 1773532800, 1773619200) AS fb);
----
true	true

# A recurring meeting is busy every week, not once — the answer comes from
# ical::Expand, so the same rule that draws the calendar decides availability.
# A window covering three Sundays must report three periods, and the last one
# must be clipped to the window rather than running past it.
#
# Unfolded first: three periods on one property overrun 75 octets, so RFC 5545
# folding splits the line and a client stitches it back. Asserting the folded
# bytes would pin the column the fold happens to land in.
query III
SELECT replace(fb, E'\r\n ', '') LIKE '%20260315T090000Z/20260315T100000Z,20260322T090000Z/20260322T100000Z,20260329T090000Z/20260329T093000Z%',
       fb LIKE '%DTEND:20260329T093000Z%',
       -- An empty calendar is "free for the whole window", which RFC 5545
       -- §3.6.4 says is a real answer: a VFREEBUSY with no FREEBUSY property.
       qm_ical_freebusy(E'BEGIN:VCALENDAR\r\nEND:VCALENDAR\r\n', 0, 3600) NOT LIKE '%FREEBUSY;%'
FROM (SELECT qm_ical_freebusy(
  E'BEGIN:VCALENDAR\r\nVERSION:2.0\r\n' ||
  E'BEGIN:VEVENT\r\nUID:f@x\r\nDTSTAMP:20260301T120000Z\r\n' ||
  E'DTSTART:20260315T090000Z\r\nDTEND:20260315T100000Z\r\n' ||
  E'RRULE:FREQ=WEEKLY\r\nSUMMARY:Weekly\r\nEND:VEVENT\r\n' ||
  E'END:VCALENDAR\r\n', 1773532800, 1774776600) AS fb);
----
true	true	true
