# name: test/sql/citadel_store.test
# description: Schema added for zapped rooms, user preferences and registration
# group: [quackmail]

require quackmail

require quackmail_citadel

# The registration record REGI/GREG and the BBS shell's <.E>nter re<G>istration
# write. Eight fields in Citadel's own order, plus the EBIO/RBIO biography.
query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 'citadel_user_reg';
----
1

query I
SELECT string_agg(column_name, ',' ORDER BY column_index)
FROM duckdb_columns() WHERE table_name = 'citadel_user_reg';
----
username,real_name,street,city,state,zipcode,phone,email,country,bio

# Terminal geometry is added to an existing table, so it must survive an
# upgrade of a database file that predates it.
query I
SELECT count(*) FROM duckdb_columns()
WHERE table_name = 'citadel_users' AND column_name IN ('screenwidth', 'screenheight');
----
2

# citadel_room_state.flags is where RS_ZAPPED lives. It shipped in the original
# schema unused; confirm it is still there and still defaults to 0.
query I
SELECT count(*) FROM duckdb_columns()
WHERE table_name = 'citadel_room_state' AND column_name = 'flags';
----
1

statement ok
INSERT INTO citadel_room_state (username, room_num, last_read) VALUES ('nobody', 0, 0);

query II
SELECT last_read, flags FROM citadel_room_state WHERE username = 'nobody';
----
0	0

statement ok
DELETE FROM citadel_room_state WHERE username = 'nobody';

# The schema is idempotent: loading a second extension re-runs EnsureCitadelSchema,
# which must not duplicate or reset anything.
require quackmail_telnet

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 'citadel_user_reg';
----
1

# Groupware objects are found by euid, not by message number: that is how saving
# a contact or an event replaces the one already there instead of appending a
# second copy. Without an index, every such lookup scans citadel_messages — and
# a calendar does one per item it draws.
query I
SELECT count(*) FROM duckdb_indexes() WHERE index_name = 'idx_msg_euid';
----
1

# The sync tombstones, and the column list rather than just the table name.
#
# `con.Query` results are not checked in EnsureCitadelSchema, so a statement
# that will not parse fails in complete silence and every read of the table
# afterwards returns nothing. That is not hypothetical: this table was first
# written with a column called `at`, which DuckDB parses as a keyword (AT TIME
# ZONE, and the time-travel FROM ... AT clause), and the only symptom was a
# CalDAV client that never noticed a deletion.
query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 'citadel_room_tombstones';
----
1

query I
SELECT string_agg(column_name, ',' ORDER BY column_index)
FROM duckdb_columns() WHERE table_name = 'citadel_room_tombstones';
----
room_num,seq,euid,msgnum,deleted_at

# Every table EnsureCitadelSchema claims to create, in one assertion, so the
# next one added silently cannot go missing the same way.
query I
SELECT count(*) FROM duckdb_tables() WHERE table_name IN (
    'citadel_users', 'citadel_user_reg', 'citadel_floors', 'citadel_rooms',
    'citadel_messages', 'citadel_room_msgs', 'citadel_room_tombstones',
    'citadel_room_state', 'citadel_msg_flags', 'citadel_config',
    'citadel_sessions', 'citadel_user_prefs', 'citadel_room_acl',
    'citadel_express');
----
14

# The token a collection's ctag and sync-token are built from spans both halves:
# the largest message number pointed into the room, and the largest tombstone
# sequence. A deletion has to move it, which is the whole reason the table
# exists — citadel_rooms.highest_msg only ever grows.
statement ok
INSERT INTO citadel_room_tombstones (room_num, seq, euid, msgnum, deleted_at)
VALUES (0, 999999, 'gone@example.com', 4242, 1753900000);

query I
SELECT greatest(
    coalesce((SELECT max(msgnum) FROM citadel_room_msgs WHERE room_num = 0), 0),
    coalesce((SELECT max(seq) FROM citadel_room_tombstones WHERE room_num = 0), 0));
----
999999

statement ok
DELETE FROM citadel_room_tombstones WHERE seq = 999999;
