# name: test/sql/quackmail.test
# description: QuackCit extensions load and their control functions work
# group: [quackmail]

require quackmail

require quackmail_smtp_in

require quackmail_managesieve

require quackmail_imap

require quackmail_pop3

require quackmail_telnet

require quackmail_nntp

require quackmail_xmpp

require quackmail_http

require quackmail_spool

# Umbrella version + schema-backed status
query I
SELECT version FROM qm_version();
----
QuackCit 0.7.0

# Adding a user succeeds and is reflected in qm_status
query II
SELECT ok, note FROM qm_user_add('carol', 'pw');
----
true	user added

query I
SELECT value FROM qm_status() WHERE metric = 'users';
----
1

# Start the inbound SMTP listener on an ephemeral port
query I
SELECT note FROM qm_smtp_in_start('127.0.0.1', 12525);
----
started

query I
SELECT running FROM qm_smtp_in_status();
----
true

query I
SELECT note FROM qm_smtp_in_stop();
----
stopped

query I
SELECT running FROM qm_smtp_in_status();
----
false

# The LMTP local-injection listener ships in the same extension as the MX, as a
# second controller over one handler, so it must start independently.
query I
SELECT note FROM qm_lmtp_start('127.0.0.1', 12033);
----
started

query I
SELECT running FROM qm_lmtp_status();
----
true

query I
SELECT note FROM qm_lmtp_stop();
----
stopped

# ManageSieve (RFC 5804), which is how users install the filters that the
# delivery path then applies.
query I
SELECT note FROM qm_managesieve_start('127.0.0.1', 14190, starttls => true);
----
started

query I
SELECT running FROM qm_managesieve_status();
----
true

query I
SELECT note FROM qm_managesieve_stop();
----
stopped

# A second, independent extension starts on its own port. IMAP and IMAPS are
# two listeners over one implementation (Citadel's 143/993 pair), so both
# control sets must work independently.
query I
SELECT note FROM qm_imap_start('127.0.0.1', 11430);
----
started

query I
SELECT note FROM qm_imaps_start('127.0.0.1', 11993, implicit_tls => true);
----
started

query II
SELECT (SELECT running FROM qm_imap_status()), (SELECT running FROM qm_imaps_status());
----
true	true

query I
SELECT note FROM qm_imap_stop();
----
stopped

query I
SELECT note FROM qm_imaps_stop();
----
stopped

# POP3 and POP3S are two listeners over one implementation (Citadel's 110/995
# pair), so both control sets must work independently.
query I
SELECT note FROM qm_pop3_start('127.0.0.1', 11100);
----
started

query I
SELECT note FROM qm_pop3s_start('127.0.0.1', 11995, implicit_tls => true);
----
started

query II
SELECT (SELECT running FROM qm_pop3_status()), (SELECT running FROM qm_pop3s_status());
----
true	true

query I
SELECT note FROM qm_pop3_stop();
----
stopped

query I
SELECT note FROM qm_pop3s_stop();
----
stopped

# The telnet BBS shell: plaintext and implicit-TLS listeners.
query I
SELECT note FROM qm_telnet_start('127.0.0.1', 12300);
----
started

query I
SELECT note FROM qm_telnets_start('127.0.0.1', 12992, implicit_tls => true);
----
started

query I
SELECT note FROM qm_telnet_stop();
----
stopped

query I
SELECT note FROM qm_telnets_stop();
----
stopped

# NNTP and NNTPS.
query I
SELECT note FROM qm_nntp_start('127.0.0.1', 11190, starttls => true);
----
started

query I
SELECT note FROM qm_nntps_start('127.0.0.1', 11563, implicit_tls => true);
----
started

query I
SELECT note FROM qm_nntp_stop();
----
stopped

query I
SELECT note FROM qm_nntps_stop();
----
stopped

# XMPP and XMPPS.
query I
SELECT note FROM qm_xmpp_start('127.0.0.1', 15522, starttls => true);
----
started

query I
SELECT note FROM qm_xmpps_start('127.0.0.1', 15523, implicit_tls => true);
----
started

query I
SELECT note FROM qm_xmpp_stop();
----
stopped

query I
SELECT note FROM qm_xmpps_stop();
----
stopped

# The web front-end: a plaintext listener (which redirects to HTTPS unless
# qm_web_force_https is turned off) and an implicit-TLS one.
query I
SELECT note FROM qm_http_start('127.0.0.1', 18080);
----
started

query I
SELECT note FROM qm_https_start('127.0.0.1', 18443, implicit_tls => true);
----
started

query II
SELECT (SELECT running FROM qm_http_status()), (SELECT running FROM qm_https_status());
----
true	true

query I
SELECT note FROM qm_http_stop();
----
stopped

query I
SELECT note FROM qm_https_stop();
----
stopped

# The spooler binds nothing — it is a thread and a clock — so its controls are
# the same start/stop/status trio over a PeriodicWorker rather than a socket.
query I
SELECT note FROM qm_listserv_start(poll_secs => 5);
----
started

query II
SELECT worker, running FROM qm_listserv_status();
----
listserv	true

# Starting an already-running worker is an error, not a second thread.
query I
SELECT note FROM qm_listserv_start();
----
error: already running

query I
SELECT note FROM qm_listserv_stop();
----
stopped

query I
SELECT running FROM qm_listserv_status();
----
false

# One pass on demand. With no lists configured there is nothing to do, which is
# the answer it must give rather than an error.
query IIII
SELECT distributed, recipients, digests, note FROM qm_listserv_run();
----
0	0	0	ok

# The fetch worker is the same shape over the same PeriodicWorker.
query I
SELECT note FROM qm_fetch_start(poll_secs => 5);
----
started

query II
SELECT worker, running FROM qm_fetch_status();
----
fetch	true

query I
SELECT note FROM qm_fetch_stop();
----
stopped

# With no feeds configured, polling everything is zero rows rather than an error.
query I
SELECT count(*) FROM qm_fetch_run();
----
0

query III
SELECT feed, status, error FROM qm_fetch_run(feed => 'nosuchfeed');
----
nosuchfeed	error	no feed called 'nosuchfeed'

# ---- the ACME worker -------------------------------------------------------
#
# The third worker in the spool extension. Its controls have the same shape as
# the other two, and it has the one-shot run function every worker here gets.

query II
SELECT worker, running FROM qm_acme_start(poll_secs => 3600);
----
acme	true

query I
SELECT note FROM qm_acme_stop();
----
stopped

# Off by default, and it says so rather than doing nothing quietly. Pointing a
# fresh install at a real CA is an operator's decision.
query II
SELECT status, note FROM qm_acme_run();
----
disabled	qm_acme_enabled is off

# The tables the worker and the HTTP challenge responder share. Asserted by
# column list rather than by name: EnsureSchema does not check con.Query's
# result, so a CREATE TABLE that will not parse fails in total silence.
query I
SELECT count(*) FROM (SELECT token, key_auth, name, expires FROM quackmail_acme_challenges);
----
0

query I
SELECT count(*) FROM (SELECT name, domains, status, attempts, next_attempt, error
                        FROM quackmail_acme_orders);
----
0

query I
SELECT count(*) FROM (SELECT name, domains, cert_pem, key_pem, not_after, cert_path
                        FROM quackmail_acme_certs);
----
0

query I
SELECT count(*) FROM (SELECT directory_url, account_url, key_pem, contact, tos_agreed
                        FROM quackmail_acme_accounts);
----
0

# A name that would become a file path, or an empty domain list, is refused
# rather than filed.
query IIII
SELECT (SELECT ok FROM qm_acme_order('../etc/x', 'example.com')),
       (SELECT ok FROM qm_acme_order('', 'example.com')),
       (SELECT ok FROM qm_acme_order('web', '')),
       (SELECT ok FROM qm_acme_order('web', 'example.com'));
----
false	false	false	true

# The listener sweep finds the tls_reload functions that are actually loaded,
# and **excludes its own wrapper** — a sweep that finds itself recurses until
# the stack runs out, which is exactly what happened the first time.
query I
SELECT count(*) FROM qm_acme_reload() WHERE function_name LIKE 'qm_acme%';
----
0

# The JMAP upload staging table.
#
# Asserted by column list rather than just by name, for the same reason
# citadel_room_tombstones is: EnsureSchema does not check con.Query's result, so
# a CREATE TABLE that will not parse fails in total silence and every later read
# returns nothing. `size` and `data` are avoided here on purpose.
query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 'quackmail_jmap_blobs';
----
1

query I
SELECT string_agg(column_name, ',' ORDER BY column_index)
FROM duckdb_columns() WHERE table_name = 'quackmail_jmap_blobs';
----
blob_id,username,content_type,size_bytes,payload,created_at
