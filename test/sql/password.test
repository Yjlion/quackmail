# name: test/sql/password.test
# description: password storage — scrypt, and the legacy rows an upgrade must not lock out
# group: [quackmail]

require quackmail

statement ok
LOAD quackmail;

# Passwords are the one part of this server whose failure is silent and
# permanent: nothing misbehaves, nobody notices, and the damage only appears
# after a database leak. Two things are pinned here — that a freshly hashed
# password round-trips, and that every row written by the *previous* scheme
# still verifies, because an upgrade that locked existing users out would be
# worse than the weakness it fixed.

# ---- the legacy scheme -----------------------------------------------------
# One round of salted SHA-256 over "<salt>:<password>". The literal below was
# computed independently rather than by asking the server what it produces, so
# this pins the stored format itself: if the legacy path is ever "tidied", an
# existing database stops letting anybody in and this is what says so.

query IIII
SELECT qm_password_check('correct horse', 'sha256', s, h),
       qm_password_check('wrong horse',   'sha256', s, h),
       -- an absent algo is the same legacy scheme; the column was added with a
       -- default and the oldest rows may predate it
       qm_password_check('correct horse', '', s, h),
       qm_password_check('correct horse', 'sha256', s, replace(h, 'f', 'e'))
FROM (SELECT '0123456789abcdef0123456789abcdef' AS s,
             '275839014dd65518f7a8c1240e60d55dd582f171c47db71069758af966ebc38f' AS h);
----
true	false	true	false

# ...and it is reported as needing a rewrite, which is what makes the upgrade
# happen on the owner's next sign-in rather than never.
query III
SELECT qm_password_needs_rehash('sha256'),
       qm_password_needs_rehash(''),
       qm_password_needs_rehash('scrypt$16384$8$1');
----
true	true	false

# ---- scrypt ----------------------------------------------------------------
# Non-deterministic by construction — a fresh salt per call — so what is
# asserted is the round trip, and that two hashes of the same password differ.
# A KDF that produced the same bytes twice would mean the salt was not being
# used, which is exactly the bug an unsalted store has.

query IIII
SELECT split_part(a, ':', 1) = 'scrypt$16384$8$1',
       qm_password_check('hunter2', split_part(a, ':', 1), split_part(a, ':', 2),
                         split_part(a, ':', 3)),
       qm_password_check('hunter3', split_part(a, ':', 1), split_part(a, ':', 2),
                         split_part(a, ':', 3)),
       a <> qm_password_hash('hunter2')
FROM (SELECT qm_password_hash('hunter2') AS a);
----
true	true	false	true

# A work factor below the current default is a rewrite candidate; one at or
# above it is not. This is what lets the cost be raised later without
# invalidating anything already stored.
query IIII
SELECT qm_password_needs_rehash('scrypt$8192$8$1'),
       qm_password_needs_rehash('scrypt$32768$8$1'),
       qm_password_needs_rehash('scrypt$16384$4$1'),
       qm_password_needs_rehash('bcrypt$12');
----
true	false	true	true

# A row stored at a *lower* factor still verifies — raising the cost must not
# lock out everyone who has not signed in since. The vector is at N=1024, small
# enough to state literally, and was produced by scrypt itself rather than by
# this server.
query II
SELECT qm_password_check('hunter2', 'scrypt$1024$8$1',
                         '00112233445566778899aabbccddeeff', h),
       qm_password_needs_rehash('scrypt$1024$8$1')
FROM (SELECT '02208c2f2e7601bf09cfe546a9348168736262af232b076a42b99da8334f4f5c' AS h);
----
true	true

# Nonsense in the algo column is refused rather than guessed at. These come out
# of a database, and an absurd N would let one sign-in allocate the machine.
query IIII
SELECT qm_password_check('x', 'scrypt$0$8$1', 'aa', 'bb'),
       qm_password_check('x', 'scrypt$99999999$8$1', 'aa', 'bb'),
       qm_password_check('x', 'scrypt$16384', 'aa', 'bb'),
       qm_password_check('x', 'argon2id$v=19', 'aa', 'bb');
----
false	false	false	false
