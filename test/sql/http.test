# name: test/sql/http.test
# description: The web front-end's pure codecs — percent-encoding, HTML escaping, path normalization
# group: [quackmail]

require quackmail

# ---- percent-decoding ------------------------------------------------------

# '+' is a space in form data (query strings, urlencoded bodies) but a literal
# '+' in a path, so the caller chooses.
query II
SELECT qm_url_decode('a%20b+c', true), qm_url_decode('a%20b+c', false);
----
a b c	a b+c

# An invalid or truncated escape is passed through literally rather than
# dropped: decoding must never silently lose bytes.
query III
SELECT qm_url_decode('%zz', false), qm_url_decode('100%', false), qm_url_decode('%4', false);
----
%zz	100%	%4

query I
SELECT qm_url_decode('%48%65%6c%6C%6F', false);
----
Hello

# ---- percent-encoding ------------------------------------------------------

# Unreserved characters (RFC 3986) survive; everything else is escaped.
query II
SELECT qm_url_encode('abcXYZ019-._~'), qm_url_encode('a b/c?d=e&f#g');
----
abcXYZ019-._~	a%20b%2Fc%3Fd%3De%26f%23g

# Round-trips over input that would break a naive encoder.
query I
SELECT count(*) FROM (VALUES
    ('<script>alert(1)</script>'),
    ('a=1&b=2'),
    ('../../etc/passwd'),
    ('%00%0d%0a'),
    ('café ☕'),
    ('"quoted" ''single'''),
    ('')
) AS t(s)
WHERE qm_url_decode(qm_url_encode(s), false) <> s;
----
0

# ---- HTML escaping ---------------------------------------------------------

# Note &#39; and not &apos;: the latter is not valid HTML4, and message bodies
# arrive from inbound SMTP, so this is the function standing between a hostile
# sender and script execution in a reader's browser.
query I
SELECT qm_html_escape('<script>&"''');
----
&lt;script&gt;&amp;&quot;&#39;

query I
SELECT qm_html_escape('plain text 123');
----
plain text 123

# Escaping is not idempotent, and must not be applied twice.
query I
SELECT qm_html_escape(qm_html_escape('<b>'));
----
&amp;lt;b&amp;gt;

# ---- path normalization ----------------------------------------------------

query III
SELECT qm_url_path('/mail/Mail'), qm_url_path('/mail//Mail'), qm_url_path('/mail/');
----
/mail/Mail	/mail/Mail	/mail/

# Traversal is refused outright rather than resolved — including when it is
# hidden behind percent-encoding, which is the form a scanner actually sends.
query I
SELECT count(*) FROM (VALUES
    ('/../etc/passwd'),
    ('/mail/../../etc/passwd'),
    ('%2e%2e%2fetc%2fpasswd'),
    ('/mail/%2e%2e/secret'),
    ('/mail/./x'),
    ('relative/path'),
    ('')
) AS t(p)
WHERE qm_url_path(p) IS NOT NULL;
----
0

# %2e%2e%2f really does decode to the traversal it is hiding — the assertion
# above is meaningful only because this one holds.
query I
SELECT qm_url_decode('%2e%2e%2f', false);
----
../

# ---- connection reuse ------------------------------------------------------
# Whether a connection is held open decides whether an unconsumed request body
# can be read as the next request line, so the truth table is worth pinning.

# HTTP/1.1 defaults to persistent; HTTP/1.0 never is, whatever it asks for.
query IIII
SELECT qm_http_keepalive('HTTP/1.1', ''),
       qm_http_keepalive('HTTP/1.0', ''),
       qm_http_keepalive('HTTP/1.0', 'keep-alive'),
       qm_http_keepalive('HTTP/0.9', '');
----
true	false	false	false

# `close` ends it, in any case and anywhere in the token list — a value like
# "keep-alive, close" is legal and means close.
query I
SELECT count(*) FROM (VALUES
    ('close'),
    ('Close'),
    ('CLOSE'),
    ('keep-alive, close'),
    ('close, keep-alive'),
    ('  close  '),
    ('te, close')
) AS t(c)
WHERE qm_http_keepalive('HTTP/1.1', c);
----
0

# Everything else leaves the connection open. `closed` is deliberately in this
# list: a prefix match rather than a token match would get it wrong.
query I
SELECT count(*) FROM (VALUES
    ('keep-alive'),
    ('Keep-Alive'),
    ('te'),
    ('closed'),
    ('not-close')
) AS t(c)
WHERE NOT qm_http_keepalive('HTTP/1.1', c);
----
0

# ---- DAV resource names ----------------------------------------------------
# A DAV resource name has to survive http::NormalizePath, which percent-decodes
# *before* it splits a path into segments. So percent-encoding cannot be used
# here: %2F would be decoded back into a '/' and turn one segment into two.
# qm_dav_name emits unreserved bytes only, escaping everything else as ~HH.

# The ordinary case stays readable, which is the whole reason for not just
# base64-ing the euid: '@' is the only byte a normal UID has to escape.
query II
SELECT qm_dav_name('abc-123@example.com'), qm_dav_euid('abc-123~40example.com');
----
abc-123~40example.com	abc-123@example.com

# The bytes that would otherwise break routing. '/' would split the segment and
# '%' would be decoded a second time. A '.' is safe in the middle of a name —
# that is what keeps "example.com" readable — but a *leading* one is escaped,
# because otherwise ".." would encode to itself and NormalizePath rejects it.
query IIII
SELECT qm_dav_name('a/b'), qm_dav_name('..'), qm_dav_name('a%2Fb'), qm_dav_name('a~b');
----
a~2Fb	~2E.	a~252Fb	a~7Eb

# '~' is itself unreserved, so an encoded name passes through percent-decoding
# untouched: decoding a name is a no-op, which is what makes the round trip
# exact rather than merely usually correct.
query I
SELECT qm_url_decode(qm_dav_name('a/b..c%d~e'), false);
----
a~2Fb..c~25d~7Ee

# Round-trip over everything a real UID has ever contained, plus the shapes
# that would break a naive encoder.
query I
SELECT count(*) FROM (VALUES
    ('abc-123@example.com'),
    ('040000008200E00074C5B7101A82E00800000000'),
    ('../../etc/passwd'),
    ('a/b/c'),
    ('.'),
    ('..'),
    ('%00%0d%0a'),
    ('with space'),
    ('café ☕'),
    ('~'),
    ('~41'),
    ('')
) AS t(s)
WHERE qm_dav_euid(qm_dav_name(s)) <> s;
----
0

# A name is never something the router will refuse. Nothing survives encoding
# except [A-Za-z0-9._-] and '~', so no name can be "." or ".." or contain a
# slash, whatever the euid was.
query I
SELECT count(*) FROM (VALUES
    ('../../etc/passwd'),
    ('a/b'),
    ('.'),
    ('..')
) AS t(s)
WHERE qm_dav_name(s) IN ('.', '..') OR qm_dav_name(s) LIKE '%/%';
----
0

# A malformed escape is passed through literally rather than dropped — the same
# rule qm_url_decode follows, and for the same reason: decoding must never
# silently lose bytes.
query III
SELECT qm_dav_euid('a~zz'), qm_dav_euid('a~4'), qm_dav_euid('a~');
----
a~zz	a~4	a~
